# ============================================================
# AjouEvent 부하 테스트 환경변수 템플릿
# cp k6-load-test/.env.example k6-load-test/.env.local
# ============================================================

BASE_URL=http://localhost:8080

# 테스트 유저 이메일
TEST_USER_EMAIL=test@ajou.ac.kr

# rate 프리셋 옵션 (preset=rate 사용 시)
RATE=1
DURATION=30s
VUS=5

# FCM 토큰 (브라우저에서 직접 발급 필요)
TEST_USER_FCM_TOKEN=

# 수신자 수 (기본값 1)
# 1      → TEST_USER_EMAIL 단일 유저만 등록
# N > 1  → test1@ajou.ac.kr ~ testN@ajou.ac.kr 을 동일 FCM 토큰으로 등록
#           실제 디바이스는 1개이지만 서버는 N개의 메시지를 빌드/전송
USER_COUNT=1

# 구독할 토픽 영문명 (기본값 AjouNormal)
# Type enum 값 참고: AjouNormal, Software, Dormitory, AjouScholarship ...
TOPIC=AjouNormal

# 실제 FCM 토큰 10개 (real-fcm-10users 시나리오 전용)
# fcm-test-frontend 를 브라우저 탭 10개에서 열어 각각 발급 후 쉼표로 연결
# 공백 없이 붙여씁니다.
FCM_TOKENS=cgI-b-xeRLv6r6CGYbVfum:APA91bHb6pqdaF48sNMMKph3TEhWYcYzI7LGAZPbSa5XKR4dRyjEs22GrHgnKBZ9wlogQZZtt4vbnAxfWkCZDTf4P3I7kHzcAGSnpUOaS-mWM6Wk7qG9GhE
